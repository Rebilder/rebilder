{
  "name": "@rebilder/events",
  "version": "0.7.0",
  "private": false,
  "description": "Typed request events and a batching HTTP sink for @rebilder/gateway: record which AI agents read your site and what they asked for.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebilder/rebilder.git",
    "directory": "packages/events"
  },
  "homepage": "https://rebilder.com/docs/events",
  "bugs": {
    "url": "https://github.com/rebilder/rebilder/issues",
    "email": "support@rebilder.com"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "analytics",
    "events",
    "observability",
    "edge"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^9.14.0",
    "eslint-plugin-security": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.4"
  }
}
