{
  "name": "@rebilder/profiles",
  "version": "0.2.0",
  "private": false,
  "description": "Open JSON lists of the facts each kind of web page should give AI agents: products, places, services, articles and more.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebilder/rebilder.git",
    "directory": "packages/profiles"
  },
  "homepage": "https://rebilder.com/spec/ars",
  "bugs": {
    "url": "https://github.com/rebilder/rebilder/issues",
    "email": "support@rebilder.com"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "agent-readability",
    "ars",
    "schema",
    "structured-data",
    "seo",
    "json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "profiles",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./profiles/*": "./profiles/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-plugin-security": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.4"
  }
}
