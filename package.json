{
  "name": "rebilder-sdk-workspace",
  "private": true,
  "description": "Rebilder's open-source SDK packages.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "ars:conform": "pnpm --filter @rebilder/agent-readability exec vitest run conformance"
  },
  "pnpm": {
    "overrides": {
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.4",
      "ws": ">=8.21.0"
    }
  }
}
